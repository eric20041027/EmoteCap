# Copy to .env at the repo root. Never commit .env (this repo is public).

# Server port
PORT=8787

# Blender executable used for FBX export
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender

# Optional: also copy every exported FBX + sidecar here, e.g. /path/to/UnityProject/Assets/EmoteCap
UNITY_EXPORT_DIR=

# Phase 3 only: Gemini API key
GEMINI_API_KEY=
# Phase 3 only: Gemini model id (if it is unavailable, try gemini-3.7-flash)
GEMINI_MODEL=gemini-3.8-flash
