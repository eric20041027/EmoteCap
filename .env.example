# Copy to .env at the repo root (cp .env.example .env). Never commit .env: this repo is public.

# Server port (the web app's dev server forwards /api, /files and /ws here)
PORT=8787

# Optional direct-server overrides. The single-entry source launcher sets these
# from --data-dir/--env-file before importing main; keep both outside web/dist.
EMOTECAP_DATA_DIR=
EMOTECAP_ENV_FILE=

# Blender executable, used only for FBX export.
#   macOS:   /Applications/Blender.app/Contents/MacOS/Blender
#   Windows: C:\Program Files\Blender Foundation\Blender 4.4\blender.exe
#   Linux:   blender
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender

# Optional: also copy every exported FBX + sidecar here, e.g. /path/to/YourUnityProject/Assets/EmoteCap
UNITY_EXPORT_DIR=

# Optional: Gemini API key (free from Google AI Studio). Without it, Auto-slice still splits a take at the
# pauses in your motion, but names the clips Clip_01, Clip_02, ... instead of naming and describing each move.
GEMINI_API_KEY=
# Optional: Gemini model. When it is overloaded the server falls back to gemini-3.6-flash, then gemini-3.5-flash.
GEMINI_MODEL=gemini-3.8-flash
