{
  "name": "emotecap-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "fetch-assets": "node --use-system-ca --use-env-proxy scripts/fetch-mediapipe.mjs",
    "predev": "node --use-system-ca --use-env-proxy scripts/fetch-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node --use-system-ca --use-env-proxy scripts/fetch-mediapipe.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:assets": "node --test scripts/asset-integrity.test.mjs",
    "test:security": "node --test scripts/dependency-security.test.mjs",
    "audit:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@zip.js/zip.js": "2.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.21.0 <12"
  },
  "packageManager": "npm@11.21.0"
}
